<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qcar2_ps4_teleop</name>
  <version>1.0.0</version>
  <description>Control the QCar2 with a PS4 DualShock 4 controller via Bluetooth</description>
  <maintainer email="user@qcar2.local">QCar2 Developer</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>qcar2_interfaces</depend>

  <depend>geometry_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
